<?xml version="1.0"?>
<configuration>

	<connectionStrings>
		<add name="HDFCConnection"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=HDFC-Loans;Integrated Security=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode"
			 value="None" />
	</appSettings>

	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" />
		<pages controlRenderingCompatibilityVersion="4.0" />
	</system.web>

</configuration>
